        "!pip install -q scikit-learn skl2onnx onnx onnxruntime\n",
        "\n",
        "import numpy as np\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from skl2onnx import convert_sklearn\n",
        "from skl2onnx.common.data_types import FloatTensorType\n",
        "\n",
        "# -----------------------------\n",
        "# 1. CREATE DUMMY TRAIN DATA\n",
        "# -----------------------------\n",
        "X = np.random.rand(200, 128*128*3).astype(np.float32)\n",
        "y = np.random.randint(0, 4, 200)\n",
        "\n",
        "# -----------------------------\n",
        "# 2. TRAIN SIMPLE MODEL\n",
        "# -----------------------------\n",
        "model = LogisticRegression(max_iter=200)\n",
        "model.fit(X, y)\n",
        "\n",
        "# -----------------------------\n",
        "# 3. CONVERT TO ONNX\n",
        "# -----------------------------\n",
        "initial_type = [(\"input\", FloatTensorType([None, 128*128*3]))]\n",
        "\n",
        "onnx_model = convert_sklearn(model, initial_types=initial_type)\n",
        "\n",
        "# -----------------------------\n",
        "# 4. SAVE FILE\n",
        "# -----------------------------\n",
        "with open(\"waste_model.onnx\", \"wb\") as f:\n",
        "    f.write(onnx_model.SerializeToString())\n",
        "\n",
        "print(\"✅ waste_model.onnx created successfully\")"
      ]
